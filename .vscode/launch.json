{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            "args": "${command:pickArgs}"
        },
        {
            "name": "Debug verificar-formulacao: PEQUENA",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/D02/D2-03-formular-como-busca/verificar-formulacao.py",
            "console": "integratedTerminal",
            "args": ["D02/D2-03-formular-como-busca/comum/problemas/consultas_ams.py:PEQUENA"],
            "env": { "PYTHONIOENCODING": "utf-8" },
            "justMyCode": false
        },
        {
            "name": "Debug verificar-formulacao: MAIOR",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/D02/D2-03-formular-como-busca/verificar-formulacao.py",
            "console": "integratedTerminal",
            "args": ["D02/D2-03-formular-como-busca/comum/problemas/consultas_ams.py:MAIOR"],
            "env": { "PYTHONIOENCODING": "utf-8" },
            "justMyCode": false
        }
    ]
}