# Copie este arquivo para ".env" e preencha os valores.
# O ".env" fica fora do Git (.gitignore) — nenhuma chave vai para o repositório.

# Chave gratuita do Gemini, obtida em https://aistudio.google.com/apikey
# (sem cartão de crédito — veja o GUIA-DE-INSTALACAO.md)
GEMINI_API_KEY=

# Token do Kaggle — só se o SEU domínio tiver dataset lá (veja o MAPA-DE-DATASETS).
# Crie em https://www.kaggle.com/settings (seção API → "Create New Token").
KAGGLE_TOKEN=

# A chave do DataJud (jus.br, domínio jurídico) é pública e igual para todo
# mundo — a receita jurídica já a traz embutida. NÃO precisa de linha aqui.

# ---------------------------------------------------------------------------
# Modelo usado nas chamadas. Padrão do curso (validado com chave real em 25/08/2026):
#   gemini-3.5-flash-lite  — rápido, barato em tokens, aprovado na camada gratuita
# Outros testados em 25/08/2026:
#   gemini-3.5-flash       — funciona, mas gasta ~6x mais tokens
# ATENÇÃO: gemini-2.5-flash e gemini-2.0-flash foram DESLIGADOS (HTTP 404). Não use.
# Não use apelidos "-latest": apontam para modelos diferentes com o tempo e
# quebram a reprodutibilidade ao longo dos 15 meses do curso.
# Se receber erro 404 de modelo, o próprio código explica como trocar aqui.
GEMINI_MODEL=gemini-3.5-flash-lite

# Nível de log do AMS: DEBUG, INFO, WARNING ou ERROR
AMS_LOG_LEVEL=INFO

# Modo offline (descomente para usar):
# 1 = o cliente do Gemini lê respostas gravadas em data/fixtures/ e não toca na rede.
# Use quando a cota gratuita estourar ou não houver internet.
# AMS_MODO_OFFLINE=1
